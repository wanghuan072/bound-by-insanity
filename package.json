{
  "name": "bound-by-insanity",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "size:report": "node scripts/project-size.mjs",
    "clean:cache": "pwsh -NoProfile -File scripts/clean-cache.ps1",
    "dev": "node scripts/generate-site-config.mjs && node scripts/dev-preview.mjs",
    "build": "node scripts/build-production.mjs",
    "start": "next start",
    "lint": "eslint app src dev scripts tests seo next.config.ts",
    "format:check": "prettier --check app src dev scripts tests seo data next.config.ts package.json tsconfig.json tsconfig.check.json tsconfig.production.json",
    "format": "prettier --write app src dev scripts tests seo data next.config.ts package.json tsconfig.json tsconfig.check.json tsconfig.production.json",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "node --test tests/*.test.mjs",
    "validate:dev": "node scripts/validate-content.mjs dev",
    "validate:media": "node scripts/validate-content.mjs media",
    "validate:publish": "node scripts/validate-content.mjs publish",
    "content:update": "node scripts/content-state.mjs update",
    "content:verify": "node scripts/content-state.mjs verify",
    "content:publish": "node scripts/publish-content.mjs"
  },
  "dependencies": {
    "js-yaml": "^4.3.2",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "lighthouse": "^13.5.0",
    "prettier": "^3.9.9",
    "typescript": "^5"
  }
}
